# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
WEB_URL=http://localhost:3000

# PostgreSQL Database (Neon or local)
DATABASE_URL="postgresql://user:password@localhost:5432/incident_pulse?sslmode=disable"

# Redis (Redis Cloud or local)
REDIS_URL="redis://localhost:6379"

# Security & JWT
JWT_SECRET="replace_with_a_secure_random_64_char_secret_key_in_production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Escalation Engine Timers (in seconds for testing, defaults to minutes in prod)
ESCALATION_DEFAULT_TIMEOUT_SEC=300
